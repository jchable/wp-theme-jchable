{
  "name": "jchable-themes",
  "private": true,
  "description": "Thèmes WordPress de julien.chable.net",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "@wordpress/env": {
      "simple-git": "4.0.2",
      "js-yaml": {
        "argparse": "2.0.1"
      }
    },
    "qs": "6.16.1"
  },
  "scripts": {
    "postinstall": "node tools/deps/patch-wp-env.mjs",
    "env:start": "wp-env start",
    "env:stop": "wp-env stop",
    "env:seed": "wp-env run cli wp eval-file wp-content/jchable-tools/env/seed.php",
    "env:reset": "wp-env reset all && npm run env:seed",
    "test:e2e": "playwright test",
    "test:tools": "node --test \"tools/**/*.test.mjs\"",
    "check": "wp-env run cli wp eval-file wp-content/jchable-tools/check/theme-check.php",
    "zip": "npm run build:js && node tools/zip/zip.mjs",
    "test:e2e:bureau": "playwright test -c playwright.bureau.config.ts",
    "fonts": "node tools/fonts/copy-fonts.mjs",
    "check:all": "npm run check -- jchable && npm run check -- jchable-bureau",
    "build:js": "vite build -c packages/bureau-desktop/vite.config.ts",
    "test:unit": "vitest run -c packages/bureau-desktop/vitest.config.ts",
    "typecheck": "tsc -p packages/bureau-desktop --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/chivo": "^5.3.0",
    "@fontsource/chivo-mono": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@wordpress/env": "11.17.0",
    "archiver": "^7.0.1",
    "jsdom": "^29.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
